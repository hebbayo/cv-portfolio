# Copy to .env and fill in. Never commit the real .env.
# NOTE: no inline comments -- systemd's EnvironmentFile= would read them as
# part of the value. Comments must be on their own line.

DEBUG=False

# 50+ random chars. Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Only if the frontend is served from a different origin than Django.
# Same-origin deploy (nginx, option B) -> leave empty.
CORS_ALLOWED_ORIGINS=
